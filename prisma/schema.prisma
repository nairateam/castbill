generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  type            ProfileType @default(INDIVIDUAL)
  name            String?
  email           String?
  phone           String?
  address         String?
  companyName     String?
  vatNumber       String?
  logoUrl         String?
  defaultCurrency String   @default("NGN")
  defaultTaxRate  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ProfileType {
  INDIVIDUAL
  COMPANY
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String?
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  clients   Client[]
  profile   Profile?
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  clientName    String
  clientEmail   String
  clientPhone   String?
  clientAddress String?
  senderName    String
  senderEmail   String
  senderPhone   String?
  senderAddress String?
  senderLogoUrl   String?
  senderVatNumber String?
  subtotal      Float
  discount      Float?
  tax           Float?
  total         Float
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  notes         String?
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  items         InvoiceItem[]
  currency  String  @default("NGN")
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  @@unique([userId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  rate        Float
  amount      Float
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

model Client {
    id        String   @id @default(cuid())
    userId    String
    name      String
    email     String
    phone     String?
    address   String?
    createdAt DateTime @default(now())
    updatedAt DateTime  @updatedAt
    user      User     @relation(fields: [userId], references: [id])
    invoices  Invoice[]
}